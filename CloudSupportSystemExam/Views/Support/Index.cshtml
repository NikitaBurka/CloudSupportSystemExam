@model IEnumerable<CloudSupportSystem.Models.SupportRequest>

@{
    ViewData["Title"] = "Список заявок";
}

<div class="container my-4">
    <div class="main-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>🔥 Заявки технічної підтримки</h2>
                <p class="text-muted mb-0">Керування зверненнями користувачів у реальному часі</p>
            </div>
            <a asp-action="Create" class="btn btn-cyber">+ Створити нову заявку</a>
        </div>

        <div class="table-responsive">
            <table class="table table-cyber align-middle">
                <thead>
                    <tr>
                        <th>Користувач</th>
                        <th>Тема</th>
                        <th>Пріоритет</th>
                        <th>Статус</th>
                        <th>Дата створення</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.UserName</td>
                            <td>@item.Subject</td>
                            <td>
                                <span class="badge-cyber priority-@item.Priority.ToString().ToLower()">
                                    @item.Priority
                                </span>
                            </td>
                            <td>
                                <span class="badge-cyber status-@item.Status.ToString().ToLower()">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-muted">
                                @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-action">
                                    Переглянути
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>